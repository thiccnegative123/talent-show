lol = 1 -- global

local player = game.Players.LocalPlayer
local targetOrientation = CFrame.new(
    86.072998, 105.031593, -491.421265,
    0.803467512, -0.15452981, -0.57494396,
    0, 0.965726495, -0.259561867,
    0.595348656, 0.208549529, 0.775929809
)

local teleportInterval = 0.05 -- fast but safe

local function startTeleporting(character)
    character:WaitForChild("HumanoidRootPart")
    
    spawn(function() -- run in a new thread
        while true do
            if lol == 0 then
                print("Teleporting stopped")
                break
            end

            if character and character.PrimaryPart then
                character:SetPrimaryPartCFrame(targetOrientation)
            end

            task.wait(teleportInterval)
        end
    end)
end

player.CharacterAdded:Connect(function(character)
    startTeleporting(character)
end)

if player.Character then
    startTeleporting(player.Character)
end
